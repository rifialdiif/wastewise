# Copy this file to .env and fill in your own values. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

CONFIDENCE_THRESHOLD=0.90
MAX_UPLOAD_MB=10

# Comma-separated website origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

MODEL_PATH=models/mobilenetv2_waste_classifier.tflite
KB_PATH=knowledge/waste_knowledge_base.json
CLASS_MAPPING_PATH=config/class_mapping.json
